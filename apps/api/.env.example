# Copy file nay thanh `apps/api/.env` roi dien gia tri that.
# File `.env` da nam trong .gitignore — KHONG BAO GIO commit no.
#
# Ba gia tri Firebase lay tu file JSON tai ve o buoc:
#   Firebase console -> Project settings -> Service accounts -> Generate new private key
# Xem setup.md Phase 1.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=

# BA LOI KINH DIEN voi bien nay — doc ky truoc khi dan:
#   1. PHAI co dau nhay kep bao quanh (key chua ky tu xuong dong).
#   2. Ky tu xuong dong nam o dang literal \n; code da .replace(/\\n/g, '\n') san.
#      Thieu buoc do se loi: error:1E08010C:DECODER routines::unsupported
#   3. KHONG them tien to NEXT_PUBLIC_ — do la bien cua Next.js va se nhung
#      service account key thang vao bundle trinh duyet.
FIREBASE_PRIVATE_KEY=""

# Cong cua BE. apps/web proxy /api/* toi day (xem apps/web/next.config.ts).
PORT=4000

# Origin duoc phep goi thang cong 4000 (debug bang curl/Postman).
# Trinh duyet khong dung duong nay — no di qua proxy same-origin cua Next.js.
#
# Nhan NHIEU origin, phan tach bang dau phay. Tren ban deploy dat domain that
# TRUOC localhost:
#   WEB_ORIGIN=https://<app>.vercel.app,http://localhost:3000
# Thu tu co y nghia: services/tiles.service.ts lay PHAN TU DAU lam `Referer` khi
# do tile, va Stadia tra 401 hay 200 la tuy referer. De sai thu tu thi phep do
# ket luan Stadia con song trong khi trinh duyet that van an 401 — dung trieu
# chung "ban do 401 tren ban deploy" ma bien nay sinh ra de sua.
WEB_ORIGIN=http://localhost:3000

# Dia chi lien he gan vao User-Agent khi goi Nominatim (endpoint GET /api/places).
# Dieu khoan OSM bat buoc moi request phai dinh danh ung dung + cach lien he.
# TUY CHON: co gia tri mac dinh trong place.service.ts nen bo trong van chay.
NOMINATIM_CONTACT=

# Khoa chia se cho /api/events. DE TRONG khi chay local — bo trong nghia la
# khong kiem tra, va do la mac dinh dung cho may minh.
#
# Chi dat tren ban deploy cong khai, va khi dat thi phai dat GIA TRI GIONG HET
# nhau o hai noi: bien nay tren host cua apps/api, va bien `EVENTS_WRITE_KEY`
# tren Vercel (apps/web/middleware.ts doc no de bom header). Lech nhau thi moi
# event deu bi tra 401 va `track.ts` nuot loi — hong im lang, khong bao gi.
#
# Sinh mot gia tri: openssl rand -hex 32
EVENTS_WRITE_KEY=
