# Copy file nay thanh `.env.local` roi dien gia tri that.
# `.env.local` da nam trong .gitignore — KHONG BAO GIO commit no.
#
# Next.js tu nap `.env.local` cho ca `npm run dev` lan `npm run build`, nen
# khong can lenh hay flag nao. `scripts/seed-events.js` va `analysis/` cung doc
# dung file nay.
#
# Ba gia tri Firebase lay tu file JSON tai ve o buoc:
#   Firebase console -> Project settings -> Service accounts -> Generate new private key
# Xem setup.md Phase 1.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=

# BA LOI KINH DIEN voi bien nay — doc ky truoc khi dan:
#   1. PHAI co dau nhay kep bao quanh (key chua ky tu xuong dong).
#   2. Ky tu xuong dong nam o dang literal \n; code da .replace(/\\n/g, '\n') san.
#      Thieu buoc do se loi: error:1E08010C:DECODER routines::unsupported
#   3. KHONG them tien to NEXT_PUBLIC_ — do la bien cua Next.js va se nhung
#      service account key thang vao bundle trinh duyet. Gio ca giao dien lan
#      route handler nam chung MOT project, nen quy tac nay quan trong hon truoc:
#      khong con hai package tach biet de do cho nhau nua.
FIREBASE_PRIVATE_KEY=""

# Dia chi lien he gan vao User-Agent khi goi Photon/Overpass (GET /api/places,
# /api/reverse, /api/restaurants). Dieu khoan OSM bat buoc moi request phai dinh
# danh ung dung + cach lien he.
# TUY CHON: co gia tri mac dinh trong service nen bo trong van chay.
NOMINATIM_CONTACT=

# Dang nhap bang so dien thoai + ma SMS 6 so.
# AUTH_SECRET: chuoi ngau nhien >= 32 ky tu, ky cookie `gsm_auth` va bam ma OTP.
#   Sinh bang: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   Doi gia tri = dang xuat tat ca moi nguoi. KHONG them tien to NEXT_PUBLIC_.
AUTH_SECRET=
# SMS_PROVIDER: `mock` = khong gui tin that, ma in ra console va hien tren man
#   /login (tru production). Them nha cung cap that o lib/server/services/sms.service.ts.
SMS_PROVIDER=mock
# SMS_MOCK_EXPOSE_CODE: production + mock thi mac dinh KHONG hien ma len man hinh va cung
#   khong gui tin that => khong ai dang nhap duoc. Dat `true` (vd. tren Vercel cho ban demo)
#   de hien ma tren form. Dong nghia: ai cung dang nhap duoc bang so bat ky — chi dung cho
#   app mo phong khong co du lieu that; can chat hon thi viet sender SMS that.
SMS_MOCK_EXPOSE_CODE=

# BigQuery — pipeline phan tich (scripts/bigquery/sync-events.js, docs/BIGQUERY_SETUP.md).
# Chi script doc cac bien nay; app Next.js KHONG dung. Dung SERVICE ACCOUNT RIENG cho
# BigQuery (khong dung lai key Firebase). Ba quy tac cua FIREBASE_PRIVATE_KEY o tren
# ap dung y nguyen: nhay kep, \n literal, KHONG tien to NEXT_PUBLIC_.
BIGQUERY_PROJECT_ID=
BIGQUERY_CLIENT_EMAIL=
BIGQUERY_PRIVATE_KEY=""
# Ba bien duoi co mac dinh, bo trong van chay.
BIGQUERY_DATASET=gsm_analytics
BIGQUERY_EVENTS_TABLE=fact_events
BIGQUERY_LOCATION=asia-southeast1

# KHONG CON BIEN NAO KHAC.
#
# Ban tach hai process truoc day con `PORT`, `WEB_ORIGIN` va `API_ORIGIN`. Ca ba
# bien mat khi gop ve mot project:
#   - PORT       — chi con mot process, `next dev --port 3000` da noi ro.
#   - API_ORIGIN — khong con proxy; /api/* la route cua chinh app nay.
#   - WEB_ORIGIN — phep do tile gio lay origin tu CHINH request (xem
#                  app/api/tiles/route.ts), nen khong con gi de dat sai.
