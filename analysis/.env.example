# File nay la TUY CHON. Khong co no script van chay duoc.
#
# `fetch_events.py` doc cau hinh Cloudflare D1 theo thu tu: .env.local (goc repo) -> file nay -> bien moi truong.
# .env.local la DUNG NGUON MA `npm run dev` DANG DUNG: ai chay duoc app thi chay duoc luon script phan tich.
# Chi tao file nay khi ban muon script Python doc mot database D1 KHAC voi database ma app dang ghi vao.
#
# Copy thanh `analysis/.env` (da nam trong .gitignore). Token chi can quyen DOC D1.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Tuy chon — mac dinh lay `database_id` trong wrangler.jsonc:
CLOUDFLARE_D1_DATABASE_ID=
